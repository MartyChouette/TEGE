# =============================================================================
# Enjin Engine .gitignore
# Custom C++20/Vulkan game engine — Windows (MSVC), Linux (GCC/Clang), macOS
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — webhook URLs, API keys (never commit)
# -----------------------------------------------------------------------------
Engine/include/Enjin/Editor/WebhookConfig.h

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
/build/
out/
x64/
/Debug/
Release/
MinSizeRel/
RelWithDebInfo/

# Object files & libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Linker output
*.exp
*.ilk
*.ipdb
*.iobj

# Debug symbols
*.pdb
*.dSYM/

# Precompiled headers
*.pch
*.gch

# -----------------------------------------------------------------------------
# CMake
# -----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
# Ignore generated cmake files but NOT CMakeLists.txt
*.cmake
!CMakeLists.txt

# -----------------------------------------------------------------------------
# Visual Studio
# -----------------------------------------------------------------------------
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.sdf
*.opensdf
*.ncb
*.opendb
*.db
*.VC.db
*.cache
ipch/
*.aps
*.user

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Third-party dependencies (fetched by CMake / submodules)
# imguizmo is committed directly — force-tracked, not affected by this rule
# -----------------------------------------------------------------------------
# imgui/angelscript/nanosvg are VENDORED (tracked) as of 2026-08-18 so fresh
# clones build - see third_party/VERSIONS.md. Only build litter is ignored.
third_party/imgui/examples/
third_party/imgui/docs/
third_party/imgui/.github/
third_party/imgui/misc/
deps/
_deps/
external/

# -----------------------------------------------------------------------------
# Compiled shaders (SPIR-V) — regenerated from GLSL source
# -----------------------------------------------------------------------------
*.spv
Engine/shaders/temp_*
Engine/shaders/*_data.txt

# -----------------------------------------------------------------------------
# Runtime output (generated by editor/player at runtime)
# -----------------------------------------------------------------------------
*.log
imgui.ini
*.enjpak
exported_sprite.*

# Loose script dirs emitted next to build outputs (embedded enjin_api copies).
# Deliberately NOT a bare scripts/ rule - that silently swallowed the repo's
# own tooling in /scripts and the golden scene's canary script.
web-demo/scripts/
web-demo/Build/
Tests/GoldenScene/replays/

# -----------------------------------------------------------------------------
# Claude Code / AI tooling
# -----------------------------------------------------------------------------
.claude/

# -----------------------------------------------------------------------------
# Test/scratch assets in repo root
# -----------------------------------------------------------------------------
/*.glb
/*.gltf
/*.fbx
/*.obj
/*.enjprefab
/*.png
nul

# Local test/scratch game project (nested git repo, bundles a web export zip)
/MyGame/

# -----------------------------------------------------------------------------
# In-source MSBuild/CMake artifacts (real build is out-of-source in build/).
# These were committed once from an accidental in-source `cmake .`; ignore so
# they never churn again. Covers the *.dir intermediate folders and their logs.
# -----------------------------------------------------------------------------
*.dir/
*.tlog
*.recipe
*.lastbuildstate
/ALL_BUILD.*
/ZERO_CHECK.*
/PACKAGE.*
/INSTALL.*
/bin/
/lib/
installer/output/

# CMake-generated header in the web build tree (only build-web/bin binaries are tracked)
build-web/Core/

# third_party/imgui: parked local clone metadata (see third_party/VERSIONS.md)
.git-local/

# Probe / debug scripts (session tooling at repo root, never shipped)
/_*.ps1
/_*.py
/_*.bat
/_*.md
/build_release.bat
vk_layer_settings*.txt
__pycache__/

# Untracked upstream imgui clutter (only the vendored glfw+vulkan backends are tracked)
third_party/imgui/backends/
third_party/imgui/.editorconfig
third_party/imgui/.gitattributes
third_party/imgui/.gitignore
third_party/imgui/docs/
third_party/imgui/examples/
third_party/imgui/misc/
