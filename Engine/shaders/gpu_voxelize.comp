#version 450

// GPU Mesh Voxelization — converts scene geometry to a 3D SDF volume.
// Reads vertex/index data from MergedGeometryBuffer, writes to 3D image (R16F).
// Each invocation processes one triangle and writes to all voxels it overlaps.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Voxel grid output — R16F, each texel stores signed distance
layout(set = 0, binding = 0, r16f) writeonly uniform image3D voxelGrid;

// Scene geometry (merged vertex + index buffers)
struct Vertex {
    vec3 position;
    vec3 normal;
    vec2 uv;
    vec4 color;
    vec4 tangent;
    vec4 boneWeights;
    uvec4 boneIndices;
};

layout(set = 0, binding = 1) readonly buffer VertexBuffer {
    float vertices[];  // Packed: 24 floats per vertex (96 bytes)
};

layout(set = 0, binding = 2) readonly buffer IndexBuffer {
    uint indices[];
};

// Per-mesh instance data
struct MeshInstance {
    mat4 transform;
    uint indexOffset;
    uint indexCount;
    uint vertexOffset;
    uint _pad;
};

layout(set = 0, binding = 3) readonly buffer InstanceBuffer {
    MeshInstance instances[];
};

// Voxelization parameters
layout(set = 0, binding = 4) uniform VoxelParams {
    vec3 gridOrigin;     // World-space origin of the voxel grid
    float voxelSize;     // Size of one voxel in world units
    ivec3 gridResolution; // Grid dimensions (e.g., 64x64x64)
    uint triangleCount;  // Total triangles to process
    uint instanceCount;  // Number of mesh instances
};

// Read a vertex position from the packed vertex buffer
vec3 readVertexPosition(uint vertexIndex) {
    uint base = vertexIndex * 24; // 24 floats per vertex
    return vec3(vertices[base], vertices[base + 1], vertices[base + 2]);
}

// Read a vertex normal from the packed vertex buffer
vec3 readVertexNormal(uint vertexIndex) {
    uint base = vertexIndex * 24 + 3; // Offset by 3 floats (position)
    return vec3(vertices[base], vertices[base + 1], vertices[base + 2]);
}

// Conservative triangle-AABB overlap test (simplified: uses triangle AABB)
void voxelizeTriangle(vec3 v0, vec3 v1, vec3 v2, vec3 n) {
    // Compute triangle AABB in voxel space
    vec3 minP = min(min(v0, v1), v2);
    vec3 maxP = max(max(v0, v1), v2);

    // Convert to grid coordinates
    ivec3 minVoxel = ivec3(floor((minP - gridOrigin) / voxelSize));
    ivec3 maxVoxel = ivec3(ceil((maxP - gridOrigin) / voxelSize));

    // Clamp to grid bounds
    minVoxel = max(minVoxel, ivec3(0));
    maxVoxel = min(maxVoxel, gridResolution - 1);

    // For each voxel in the triangle's AABB, write opacity
    for (int z = minVoxel.z; z <= maxVoxel.z; ++z) {
        for (int y = minVoxel.y; y <= maxVoxel.y; ++y) {
            for (int x = minVoxel.x; x <= maxVoxel.x; ++x) {
                // Simple occupancy: mark voxel as solid (distance = 0 at surface)
                // A full SDF would compute signed distance to triangle plane,
                // but for DDGI probe tracing, binary occupancy is sufficient.
                imageStore(voxelGrid, ivec3(x, y, z), vec4(0.0, 0.0, 0.0, 0.0));
            }
        }
    }
}

void main() {
    uint triIndex = gl_GlobalInvocationID.x;
    if (triIndex >= triangleCount) return;

    // Find which mesh instance this triangle belongs to
    // (linear scan — could be accelerated with prefix sum)
    uint runningTriCount = 0;
    uint instIdx = 0;
    for (uint i = 0; i < instanceCount; ++i) {
        uint instTriCount = instances[i].indexCount / 3;
        if (triIndex < runningTriCount + instTriCount) {
            instIdx = i;
            triIndex -= runningTriCount;
            break;
        }
        runningTriCount += instTriCount;
    }

    MeshInstance inst = instances[instIdx];
    uint baseIndex = inst.indexOffset + triIndex * 3;

    // Read triangle indices
    uint i0 = indices[baseIndex + 0] + inst.vertexOffset;
    uint i1 = indices[baseIndex + 1] + inst.vertexOffset;
    uint i2 = indices[baseIndex + 2] + inst.vertexOffset;

    // Read and transform vertex positions
    vec3 p0 = (inst.transform * vec4(readVertexPosition(i0), 1.0)).xyz;
    vec3 p1 = (inst.transform * vec4(readVertexPosition(i1), 1.0)).xyz;
    vec3 p2 = (inst.transform * vec4(readVertexPosition(i2), 1.0)).xyz;

    // Compute face normal
    vec3 edge1 = p1 - p0;
    vec3 edge2 = p2 - p0;
    vec3 normal = normalize(cross(edge1, edge2));

    voxelizeTriangle(p0, p1, p2, normal);
}
