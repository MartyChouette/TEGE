#version 450

// GPU Particle Simulation — update position, velocity, lifetime on GPU.
// Each invocation updates one particle. Dead particles are compacted by
// the indirect draw buffer (alive particles write their index to an append buffer).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Particle state (read-write SSBO)
struct Particle {
    vec3 position;
    float lifetime;      // Remaining lifetime (seconds). <= 0 = dead.
    vec3 velocity;
    float age;           // Total age (seconds since spawn)
    vec4 color;          // Current RGBA (interpolated over lifetime)
    float size;          // Current billboard size
    float rotation;      // Billboard rotation angle
    float gravityScale;  // Per-particle gravity multiplier (0 = float, <0 = rise)
    float drag;          // Per-particle extra velocity damping (per second)
    vec4 spriteParams;   // x=sprite card, y=softness, z=texIndex, w=emitterKey
    vec4 collision;      // x=bounciness, y=slide keep, z=extra radius, w=collide flag
};

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// Alive particle index list for indirect draw (append buffer)
layout(std430, set = 0, binding = 1) buffer AliveIndexBuffer {
    uint aliveCount;    // Atomic counter (reset to 0 before dispatch)
    uint aliveIndices[];
};

// Emitter parameters
layout(set = 0, binding = 2) uniform EmitterParams {
    vec3 emitterPosition;
    float deltaTime;
    vec3 emitterDirection;
    float emitterSpread;    // Cone half-angle (radians)
    vec3 gravity;
    float damping;          // Velocity damping per second (0 = none, 1 = full stop)
    vec3 windForce;         // Global wind force (from WindSystem)
    uint maxParticles;
    vec4 startColor;
    vec4 endColor;
    float startSize;
    float endSize;
    float maxLifetime;
    float spawnRate;        // Particles per second
    float turbulenceStrength;
    float turbulenceFrequency;
    uint frameNumber;
    uint colliderCount;    // shapes in the collider buffer (0 = no collision)
};

// World collider shapes (box/sphere/capsule) particles bounce off.
struct ColliderShape {
    vec4 posKind;   // xyz = center, w = kind (0 box, 1 sphere, 2 capsule)
    vec4 rot;       // entity rotation quaternion
    vec4 dims;      // box: half extents | sphere: x=r | capsule: x=r, y=halfHeight
};
layout(std430, set = 0, binding = 3) readonly buffer ColliderBuffer {
    ColliderShape shapes[];
};

// Impact events, ping-ponged by frame parity so the CPU can read the slot
// written two frames ago while the in-flight frame writes the other one.
// events stride 2: [0] = xyz pos + w impact speed, [1] = x emitterKey.
layout(std430, set = 0, binding = 4) buffer ImpactEventBuffer {
    uint eventCounts[2];
    uint _evPad[2];
    vec4 events[];
};

vec3 QuatRotate(vec4 q, vec3 v) {
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}
vec3 QuatRotateInv(vec4 q, vec3 v) {
    return QuatRotate(vec4(-q.xyz, q.w), v);
}

// Simple hash for pseudo-random per-particle noise
float hash(uint n) {
    n = (n << 13u) ^ n;
    n = n * (n * n * 15731u + 789221u) + 1376312589u;
    return float(n & 0x7FFFFFFFu) / float(0x7FFFFFFF);
}

vec3 turbulence(vec3 pos, float freq, float strength, uint seed) {
    // Cheap curl-noise approximation using hash
    float h = 0.01;
    vec3 p = pos * freq;
    float nx = hash(seed + uint(p.x * 73.0 + p.y * 157.0 + p.z * 113.0));
    float ny = hash(seed + uint(p.x * 97.0 + p.y * 131.0 + p.z * 89.0));
    float nz = hash(seed + uint(p.x * 61.0 + p.y * 173.0 + p.z * 149.0));
    return (vec3(nx, ny, nz) * 2.0 - 1.0) * strength;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= maxParticles) return;

    Particle p = particles[idx];

    // Skip dead particles
    if (p.lifetime <= 0.0) return;

    // Update lifetime
    p.lifetime -= deltaTime;
    p.age += deltaTime;

    if (p.lifetime <= 0.0) {
        // Particle died this frame — don't add to alive list
        particles[idx] = p;
        return;
    }

    // Stain (collision.w == 2): a surface mark, not a moving particle. No
    // physics, no collision — it just ages in place (velocity holds the
    // surface normal for the draw shader's orientation).
    if (p.collision.w > 1.5) {
        particles[idx] = p;
        uint stainAlive = atomicAdd(aliveCount, 1u);
        if (stainAlive < maxParticles) { aliveIndices[stainAlive] = idx; }
        return;
    }

    // Physics update — gravity is scaled per particle so presets differ
    // (sparks fall hard, smoke rises with a negative scale, mist floats at 0).
    vec3 acceleration = gravity * p.gravityScale;
    acceleration += windForce;

    // Turbulence
    if (turbulenceStrength > 0.0) {
        acceleration += turbulence(p.position, turbulenceFrequency, turbulenceStrength, idx + frameNumber);
    }

    // Velocity integration with global + per-particle drag
    p.velocity += acceleration * deltaTime;
    p.velocity *= (1.0 - (damping + p.drag) * deltaTime);

    // Position integration. With colliders present the motion is substepped so
    // a fast particle can't tunnel through a thin shape in one frame step.
    uint substeps = (colliderCount > 0u && p.collision.w > 0.5) ? 4u : 1u;
    float stepDt = deltaTime / float(substeps);
    for (uint ss = 0u; ss < substeps; ++ss) {
    p.position += p.velocity * stepDt;

    // Collision: push out of world shapes and bounce (restitution 0.35,
    // tangential friction keeps 70% of slide velocity).
    if (p.collision.w > 0.5) {
    for (uint s = 0u; s < colliderCount && s < 32u; ++s) {
        vec3 sc = shapes[s].posKind.xyz;
        int kind = int(shapes[s].posKind.w + 0.5);
        vec3 n = vec3(0.0);
        float pen = 0.0;
        float skin = 0.02 + p.collision.z;

        if (kind == 1) {                       // sphere
            vec3 d = p.position - sc;
            float dist = length(d);
            float r = shapes[s].dims.x + skin;
            if (dist < r) { n = (dist > 1e-6) ? d / dist : vec3(0, 1, 0); pen = r - dist; }
        } else if (kind == 2) {                // capsule (axis = entity up)
            vec3 axis = QuatRotate(shapes[s].rot, vec3(0, 1, 0));
            vec3 d = p.position - sc;
            float t = clamp(dot(d, axis), -shapes[s].dims.y, shapes[s].dims.y);
            vec3 closest = sc + axis * t;
            vec3 rd = p.position - closest;
            float dist = length(rd);
            float r = shapes[s].dims.x + skin;
            if (dist < r) { n = (dist > 1e-6) ? rd / dist : vec3(0, 1, 0); pen = r - dist; }
        } else {                               // box (OBB)
            vec3 lp = QuatRotateInv(shapes[s].rot, p.position - sc);
            vec3 h = shapes[s].dims.xyz + vec3(skin);
            vec3 a = abs(lp);
            if (a.x < h.x && a.y < h.y && a.z < h.z) {
                vec3 depth = h - a;
                vec3 ln;
                if (depth.x <= depth.y && depth.x <= depth.z)      { ln = vec3(sign(lp.x), 0, 0); pen = depth.x; }
                else if (depth.y <= depth.x && depth.y <= depth.z) { ln = vec3(0, sign(lp.y), 0); pen = depth.y; }
                else                                              { ln = vec3(0, 0, sign(lp.z)); pen = depth.z; }
                n = QuatRotate(shapes[s].rot, ln);
            }
        }

        if (pen > 0.0) {
            p.position += n * pen;
            float vn = dot(p.velocity, n);
            if (vn < 0.0) {
                vec3 vTan = p.velocity - vn * n;
                p.velocity = vTan * p.collision.y - n * (vn * p.collision.x);
                // Report meaningful strikes (resting contacts stay under 0.5)
                float impact = -vn;
                if (impact > 0.5) {
                    uint slot = frameNumber & 1u;
                    uint ei = atomicAdd(eventCounts[slot], 1u);
                    if (ei < 64u) {
                        events[(slot * 64u + ei) * 2u]      = vec4(p.position, impact);
                        events[(slot * 64u + ei) * 2u + 1u] = vec4(p.spriteParams.w, n);
                    }
                }
            }
        }
    }
    }   // collide flag
    }   // substeps

    // Color and size stay as baked at spawn (per-preset). The alpha fade over
    // life happens in the draw fragment shader from age/lifetime, so the sim
    // never clobbers the per-particle preset color.

    // Write back
    particles[idx] = p;

    // Append to alive list for indirect draw
    uint aliveIdx = atomicAdd(aliveCount, 1u);
    if (aliveIdx < maxParticles) {
        aliveIndices[aliveIdx] = idx;
    }
}
