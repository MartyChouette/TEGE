#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 5, set = 0, r16f) uniform image2D shadowOutput;
layout(binding = 2, set = 0) uniform sampler2D depthTex;
layout(binding = 3, set = 0) uniform sampler2D normalTex;

layout(binding = 13, set = 0) uniform LightData {
    vec4 lightDir;      // xyz=direction, w=intensity
    vec4 lightColor;    // xyz=color, w=shadowDistance
    mat4 invViewProj;
    vec2 screenSize;
    uint frameCount;
    float shadowRadius;
    // Path tracer config (not used here, but layout must match)
    float fireflyClamp;
    int enableNEE;
    int enableMIS;
    int rrMinBounce;
    float rrMinProb;
    uint directionalLightCount;
    uint pointLightCount;
    uint spotLightCount;
} uLight;

// ReSTIR reservoir buffer (binding 19) — per-pixel importance-selected light
struct Reservoir {
    uint selectedLight;  // Index into NEE light SSBO
    float weightSum;     // Running weight sum
    float sampleWeight;  // Unbiased weight for the selected sample (W)
    uint sampleCount;    // M — number of candidates that contributed
};

layout(binding = 19, set = 0) readonly buffer ReservoirBuffer {
    Reservoir reservoirs[];
};

// NEE light SSBO (binding 16) — scene lights for ReSTIR-guided shadow rays
struct RTLightShadow {
    vec3 position;
    float range;
    vec3 direction;
    float intensity;
    vec3 color;
    int type;          // 0=directional, 1=point, 2=spot
    float innerCutoff;
    float outerCutoff;
    float _pad0;
    float _pad1;
};

layout(binding = 16, set = 0) readonly buffer NEELightBuffer {
    RTLightShadow neeLights[];
};

layout(location = 0) rayPayloadEXT float shadowPayload;

#include "rt_common.glsl"

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(pixel) + 0.5) / uLight.screenSize;

    // Reconstruct world position from depth
    float depth = texture(depthTex, uv).r;
    if (depth >= 1.0) {
        imageStore(shadowOutput, pixel, vec4(1.0));
        return;
    }

    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = uLight.invViewProj * clipPos;
    worldPos /= worldPos.w;

    vec3 worldNormal = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);
    vec3 rayOrigin = worldPos.xyz + worldNormal * 0.001;

    uint seed = init_rng(uvec2(pixel), uLight.frameCount);

    // Check if ReSTIR has selected a valid light for this pixel.
    // When ReSTIR is active (sampleCount > 0, sampleWeight > 0), cast the shadow
    // ray toward the importance-selected light instead of only the primary directional.
    // This gives much better multi-light shadow convergence — the reservoir has already
    // chosen the most impactful light via importance weighting + temporal/spatial reuse.
    uint totalLights = uLight.directionalLightCount + uLight.pointLightCount + uLight.spotLightCount;
    uint reservoirIdx = uint(pixel.y) * uint(uLight.screenSize.x) + uint(pixel.x);
    Reservoir r = reservoirs[reservoirIdx];

    bool useReSTIR = (r.sampleCount > 0u && r.sampleWeight > 0.0 &&
                      r.selectedLight < totalLights && totalLights > 0u);

    vec3 rayDir;
    float tMax;

    if (useReSTIR) {
        // Cast shadow ray toward the ReSTIR-selected light
        RTLightShadow light = neeLights[r.selectedLight];

        if (light.type == 0) {
            // Directional light — ray direction is opposite light direction
            rayDir = normalize(-light.direction);
            tMax = uLight.lightColor.w;  // shadowDistance
        } else {
            // Point or spot light — ray toward light position
            vec3 toLight = light.position - worldPos.xyz;
            float dist = length(toLight);
            rayDir = toLight / max(dist, 1e-6);
            tMax = dist - 0.01;  // Stop just before the light source
        }
    } else {
        // Fallback: primary directional light (original behavior)
        rayDir = normalize(-uLight.lightDir.xyz);
        tMax = uLight.lightColor.w;
    }

    // Optional: jitter for soft shadows
    if (uLight.shadowRadius > 0.0) {
        vec3 T, B;
        build_onb(rayDir, T, B);
        vec2 jitter = rand_vec2(seed) * uLight.shadowRadius;
        rayDir = normalize(rayDir + jitter.x * T + jitter.y * B);
    }

    shadowPayload = 0.0;  // Assume occluded

    traceRayEXT(topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT,
        0xFF,           // mask
        0,              // sbtRecordOffset
        0,              // sbtRecordStride
        0,              // missIndex
        rayOrigin,
        0.001,          // tMin
        rayDir,
        tMax,           // tMax
        0               // payload location
    );

    // When using ReSTIR, modulate the shadow result by the reservoir weight.
    // This ensures the shadow contribution is correctly importance-weighted:
    // the final value is shadow_visibility * W, where W accounts for the
    // probability of having selected this particular light.
    float result = shadowPayload;
    if (useReSTIR) {
        // Clamp the reservoir weight to avoid extreme values from
        // low-probability selections (defensive, should rarely trigger)
        float w = clamp(r.sampleWeight, 0.0, 10.0);
        result *= w;
    }

    imageStore(shadowOutput, pixel, vec4(result));
}
