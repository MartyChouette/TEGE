#version 450

// Hi-Z pyramid generation: one level from the one above it, each texel the MAX
// depth of the source texels it covers (depth is 0 near, 1 far, compare LESS).
//
// MAX is the conservative choice for occlusion: a coarse texel answers "nothing
// in this area is farther than d", so an object whose nearest point is behind d
// is behind everything there. Under-reporting the max hides visible objects,
// which is the one failure culling must never have.
//
// That is why this fetches texels exactly instead of sampling between them, and
// why an ODD source dimension folds its last row/column into the last output
// texel. Halving 5 texels to 2 and reading only 4 of them dropped one column of
// depth from every coarser level.
//
// The first dispatch reads the scene depth buffer (mip 0 of the pyramid is half
// its size); every later one reads the previous pyramid level.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcDepth;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D dstMip;

layout(push_constant) uniform PushConstants {
    ivec2 srcSize;
} pc;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstMip);
    if (dst.x >= dstSize.x || dst.y >= dstSize.y) return;

    ivec2 lo = dst * 2;
    ivec2 hi = lo + 1;
    // The last output texel also covers the source's leftover row/column.
    if (dst.x == dstSize.x - 1) hi.x = pc.srcSize.x - 1;
    if (dst.y == dstSize.y - 1) hi.y = pc.srcSize.y - 1;
    hi = min(hi, pc.srcSize - 1);

    float d = 0.0;
    for (int y = lo.y; y <= hi.y; ++y) {
        for (int x = lo.x; x <= hi.x; ++x) {
            d = max(d, texelFetch(srcDepth, ivec2(x, y), 0).r);
        }
    }
    imageStore(dstMip, dst, vec4(d, 0.0, 0.0, 0.0));
}
