#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 8, set = 0, rgba16f) uniform image2D giOutput;
layout(binding = 2, set = 0) uniform sampler2D depthTex;
layout(binding = 3, set = 0) uniform sampler2D normalTex;

layout(binding = 13, set = 0) uniform LightData {
    vec4 lightDir;
    vec4 lightColor;
    mat4 invViewProj;
    vec2 screenSize;
    uint frameCount;
    float giMaxDistance;
    vec4 cameraPos;
    float giIntensity;
    int giBounces;
    float pad1, pad2;
} uLight;

layout(location = 0) rayPayloadEXT vec4 giPayload;

#include "rt_common.glsl"

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(pixel) + 0.5) / uLight.screenSize;

    float depth = texture(depthTex, uv).r;
    if (depth >= 1.0) {
        imageStore(giOutput, pixel, vec4(0.0));
        return;
    }

    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = uLight.invViewProj * clipPos;
    worldPos /= worldPos.w;

    vec3 worldNormal = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);

    // Cosine-weighted hemisphere sample for first bounce
    uint seed = init_rng(uvec2(pixel), uLight.frameCount);
    vec2 u = rand_vec2(seed);
    vec3 sampleDir = cosine_hemisphere_sample(u);

    vec3 T, B;
    build_onb(worldNormal, T, B);
    vec3 rayDir = tangent_to_world(sampleDir, worldNormal, T, B);

    vec3 rayOrigin = worldPos.xyz + worldNormal * 0.001;

    giPayload = vec4(0.0);

    traceRayEXT(topLevelAS,
        gl_RayFlagsNoneEXT,
        0xFF, 0, 0, 2,  // missIndex = 2 (sky radiance)
        rayOrigin, 0.001,
        rayDir, uLight.giMaxDistance,
        0
    );

    // GI is indirect bounce added on top of the already-lit scene. Clamp its
    // luminance so a bright sky miss can't stack into a white wash — the giStrength
    // slider still scales the final contribution in the hybrid apply pass.
    vec3 gi = giPayload.rgb * uLight.giIntensity;
    gi = clampRadiance(gi, 1.0);
    imageStore(giOutput, pixel, vec4(gi, 1.0));
}
