#version 460
layout(local_size_x = 8, local_size_y = 8) in;

// Edge-aware a-trous wavelet filter
// Uses depth, normal, and luminance as edge-stopping functions
// Step size doubles each iteration: 1, 2, 4, 8, 16

layout(binding = 1) uniform sampler2D depthTex;
layout(binding = 2) uniform sampler2D normalTex;
layout(binding = 6, r16f) uniform image2D varianceImage;
layout(binding = 7, rgba16f) uniform image2D pingImage;  // Input (read)
layout(binding = 8, rgba16f) uniform image2D pongImage;  // Output (write)

layout(push_constant) uniform PushConstants {
    int stepSize;
    float temporalAlpha;
    float sigmaDepth;
    float sigmaNormal;
    float sigmaLuminance;
    int iteration;
    int flags;
    int pad;
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// 5x5 a-trous kernel weights
const float kernel[3] = float[](1.0, 2.0/3.0, 1.0/6.0);

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(pongImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 texelSize = 1.0 / vec2(size);
    vec2 centerUV = (vec2(pixel) + 0.5) * texelSize;

    vec4 centerColor = imageLoad(pingImage, pixel);
    float centerDepth = texture(depthTex, centerUV).r;
    vec3 centerNormal = texture(normalTex, centerUV).xyz * 2.0 - 1.0;
    float centerLum = luminance(centerColor.rgb);
    float centerVariance = imageLoad(varianceImage, pixel).r;

    // Luminance sigma adapts to variance
    float sigmaL = pc.sigmaLuminance * sqrt(max(centerVariance, 1e-6));

    vec4 colorSum = centerColor;
    float weightSum = 1.0;

    int step = pc.stepSize;

    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            if (dx == 0 && dy == 0) continue;

            ivec2 samplePixel = pixel + ivec2(dx, dy) * step;
            if (samplePixel.x < 0 || samplePixel.x >= size.x ||
                samplePixel.y < 0 || samplePixel.y >= size.y) continue;

            vec2 sampleUV = (vec2(samplePixel) + 0.5) * texelSize;

            vec4 sampleColor = imageLoad(pingImage, samplePixel);
            float sampleDepth = texture(depthTex, sampleUV).r;
            vec3 sampleNormal = texture(normalTex, sampleUV).xyz * 2.0 - 1.0;
            float sampleLum = luminance(sampleColor.rgb);

            // Kernel weight
            float h = kernel[abs(dx)] * kernel[abs(dy)];

            // Depth edge-stopping
            float depthDiff = abs(centerDepth - sampleDepth);
            float wDepth = exp(-depthDiff * depthDiff / (pc.sigmaDepth * pc.sigmaDepth + 1e-6));

            // Normal edge-stopping
            float normalDot = max(0.0, dot(centerNormal, sampleNormal));
            float wNormal = pow(normalDot, pc.sigmaNormal);

            // Luminance edge-stopping
            float lumDiff = abs(centerLum - sampleLum);
            float wLum = exp(-lumDiff * lumDiff / (sigmaL * sigmaL + 1e-6));

            float w = h * wDepth * wNormal * wLum;
            colorSum += sampleColor * w;
            weightSum += w;
        }
    }

    vec4 result = colorSum / weightSum;
    imageStore(pongImage, pixel, result);
}
