#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Visibility buffer material resolve — compute shader
// Reads triangle/instance IDs from visibility buffer, fetches vertex data,
// computes barycentrics, evaluates materials, and writes final color.

// Visibility buffer input (R32G32_UINT)
layout(binding = 0, rg32ui) readonly uniform uimage2D visBuffer;

// Output color image
layout(binding = 1, rgba8) writeonly uniform image2D outputColor;

// Depth buffer for world position reconstruction
layout(binding = 2) uniform sampler2D depthTex;

// Scene vertex/index buffers
layout(std430, binding = 3) readonly buffer VertexBuffer {
    float vertices[];  // Interleaved: pos(3), normal(3), uv(2) per vertex
};

layout(std430, binding = 4) readonly buffer IndexBuffer {
    uint indices[];
};

// Per-object data
struct ObjectData {
    mat4 model;
    vec4 baseColor;     // xyz=color, w=metallic
    vec4 emissive;      // xyz=color, w=roughness
    uint vertexOffset;
    uint indexOffset;
    uint indexCount;
    uint pad;
};

layout(std430, binding = 5) readonly buffer ObjectDataBuffer {
    ObjectData objects[];
};

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    mat4 invViewProj;
    vec2 screenSize;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.screenSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    // Read visibility buffer
    uvec2 vis = imageLoad(visBuffer, pixel).rg;
    uint triangleID = vis.x;
    uint instanceID = vis.y;

    // Background pixels (no geometry)
    if (triangleID == 0xFFFFFFFFu && instanceID == 0xFFFFFFFFu) {
        imageStore(outputColor, pixel, vec4(0.1, 0.1, 0.12, 1.0));
        return;
    }

    // Fetch object data
    ObjectData obj = objects[instanceID];

    // Fetch triangle indices
    uint baseIdx = obj.indexOffset + triangleID * 3u;
    uint i0 = indices[baseIdx + 0u] + obj.vertexOffset;
    uint i1 = indices[baseIdx + 1u] + obj.vertexOffset;
    uint i2 = indices[baseIdx + 2u] + obj.vertexOffset;

    // Fetch vertex positions (stride = 8 floats: pos3 + normal3 + uv2)
    vec3 p0 = vec3(vertices[i0*8u+0u], vertices[i0*8u+1u], vertices[i0*8u+2u]);
    vec3 p1 = vec3(vertices[i1*8u+0u], vertices[i1*8u+1u], vertices[i1*8u+2u]);
    vec3 p2 = vec3(vertices[i2*8u+0u], vertices[i2*8u+1u], vertices[i2*8u+2u]);

    // Transform to world space
    vec3 wp0 = (obj.model * vec4(p0, 1.0)).xyz;
    vec3 wp1 = (obj.model * vec4(p1, 1.0)).xyz;
    vec3 wp2 = (obj.model * vec4(p2, 1.0)).xyz;

    // Compute face normal
    vec3 edge1 = wp1 - wp0;
    vec3 edge2 = wp2 - wp0;
    vec3 normal = normalize(cross(edge1, edge2));

    // Simple directional lighting (placeholder — full PBR can be added)
    vec3 lightDir = normalize(vec3(0.5, 0.8, 0.3));
    float ndotl = max(dot(normal, lightDir), 0.0);
    vec3 ambient = vec3(0.15);

    vec3 color = obj.baseColor.rgb * (ambient + ndotl * vec3(0.85));
    imageStore(outputColor, pixel, vec4(color, 1.0));
}
