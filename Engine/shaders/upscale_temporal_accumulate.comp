#version 450

// Temporal Accumulation for Upscaling — Motion-Vector-Aware History Blend
//
// This compute shader provides the temporal accumulation component for the
// built-in FSR 2-style upscaler pipeline:
//   1. EASU (edge-adaptive spatial upscale) or Lanczos at render resolution
//   2. This shader: temporal accumulation using motion vectors (at display res)
//   3. RCAS sharpening (at display res)
//
// Unlike TAA (which operates at render resolution), this shader works at
// display resolution and blends the current upscaled frame with the
// reprojected history buffer. Motion vectors drive the reprojection;
// depth/color consistency checks reject ghosting.
//
// Design notes:
//   - Operates on the upscaled (display-res) color, not the raw render-res input.
//   - Reads motion vectors from the render-resolution MRT velocity attachment
//     and scales them to display-resolution pixel space.
//   - Uses YCoCg color space for neighborhood clamping (better at rejecting
//     ghosting than RGB clamping).
//   - Outputs to a ping-pong history buffer pair.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --- Inputs ---
layout(set = 0, binding = 0) uniform sampler2D currentColor;  // Upscaled current frame (display res)
layout(set = 0, binding = 1) uniform sampler2D historyColor;  // Previous frame's accumulated result
layout(set = 0, binding = 2) uniform sampler2D velocityTex;   // Motion vectors (render res, RG16F pixels)
layout(set = 0, binding = 3) uniform sampler2D depthTex;      // Depth buffer (render res)

// --- Output ---
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputColor;

// --- Push constants ---
layout(push_constant) uniform TemporalAccumParams {
    uvec2 displaySize;     // Display resolution
    uvec2 renderSize;      // Render resolution
    float feedbackMin;     // Min history blend weight (0.88 typical)
    float feedbackMax;     // Max history blend weight (0.97 typical)
    float sharpness;       // Sharpening factor applied during blend
    uint  flags;           // bit 0: hasHistory, bit 1: cameraCut
};

// RGB <-> YCoCg conversion (better for neighborhood clamping than RGB)
vec3 RGBtoYCoCg(vec3 rgb) {
    float Y  =  0.25 * rgb.r + 0.5 * rgb.g + 0.25 * rgb.b;
    float Co =  0.5  * rgb.r               - 0.5  * rgb.b;
    float Cg = -0.25 * rgb.r + 0.5 * rgb.g - 0.25 * rgb.b;
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
    float Y = ycocg.x, Co = ycocg.y, Cg = ycocg.z;
    float r = Y + Co - Cg;
    float g = Y      + Cg;
    float b = Y - Co - Cg;
    return vec3(r, g, b);
}

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(displaySize.x) || pixel.y >= int(displaySize.y)) {
        return;
    }

    vec2 invDisplaySize = 1.0 / vec2(displaySize);
    vec2 uv = (vec2(pixel) + 0.5) * invDisplaySize;

    // Read current upscaled color
    vec3 current = texture(currentColor, uv).rgb;

    bool hasHistory = (flags & 1u) != 0u;
    bool cameraCut = (flags & 2u) != 0u;

    // On camera cut or first frame, output current color directly
    if (!hasHistory || cameraCut) {
        imageStore(outputColor, pixel, vec4(current, 1.0));
        return;
    }

    // Read motion vector (at render resolution), scale to display pixel space.
    // The velocity texture stores per-pixel velocity in render-resolution pixels.
    vec2 renderUV = uv;  // Same UV works (both are normalized [0,1])
    vec2 velocity = texture(velocityTex, renderUV).rg;

    // Scale velocity from render-resolution pixels to display-resolution pixels
    vec2 velScale = vec2(displaySize) / vec2(renderSize);
    vec2 displayVelocity = velocity * velScale;

    // Reproject: previous display-resolution pixel location
    vec2 prevUV = uv - displayVelocity * invDisplaySize;

    // Bounds check: reject reprojections that land outside the frame
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        imageStore(outputColor, pixel, vec4(current, 1.0));
        return;
    }

    // Read history at the reprojected location
    vec3 history = texture(historyColor, prevUV).rgb;

    // --- Neighborhood clamping in YCoCg space ---
    // Sample a 3x3 neighborhood of the current frame to compute the
    // acceptable color range. History values outside this range are
    // likely ghosts from disoccluded regions.
    vec3 nbMin = RGBtoYCoCg(current);
    vec3 nbMax = nbMin;
    vec3 nbSum = nbMin;
    vec3 nbSumSq = nbMin * nbMin;

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            vec2 nbUV = uv + vec2(dx, dy) * invDisplaySize;
            vec3 nbColor = RGBtoYCoCg(texture(currentColor, nbUV).rgb);
            nbMin = min(nbMin, nbColor);
            nbMax = max(nbMax, nbColor);
            nbSum += nbColor;
            nbSumSq += nbColor * nbColor;
        }
    }

    // Variance-based clamping (tighter than min/max, better ghost rejection)
    vec3 nbMean = nbSum / 9.0;
    vec3 nbVariance = max(nbSumSq / 9.0 - nbMean * nbMean, vec3(0.0));
    vec3 nbStdDev = sqrt(nbVariance);

    // Clamp range: mean +/- gamma * stddev (gamma=1.25 is a good balance)
    float gamma = 1.25;
    vec3 clampMin = nbMean - gamma * nbStdDev;
    vec3 clampMax = nbMean + gamma * nbStdDev;

    // Intersect variance-based range with min/max range (belt and suspenders)
    clampMin = max(clampMin, nbMin);
    clampMax = min(clampMax, nbMax);

    // Clamp history in YCoCg space
    vec3 historyYCoCg = RGBtoYCoCg(history);
    vec3 clampedHistory = clamp(historyYCoCg, clampMin, clampMax);
    history = YCoCgToRGB(clampedHistory);

    // --- Adaptive blend factor ---
    // Use velocity magnitude to control feedback: fast motion = less history
    // (prevents smearing), slow/static = more history (better accumulation).
    float speed = length(displayVelocity);
    float speedFactor = clamp(speed / 4.0, 0.0, 1.0);  // Normalize to ~4px
    float feedback = mix(feedbackMax, feedbackMin, speedFactor);

    // Additional check: how much did we clamp the history?
    // Large clamp distance means the history is unreliable (disocclusion).
    float clampDist = length(historyYCoCg - clampedHistory);
    float clampPenalty = clamp(clampDist * 4.0, 0.0, 0.5);
    feedback = max(feedback - clampPenalty, feedbackMin);

    // Blend current and history
    vec3 result = mix(current, history, feedback);

    // Optional: slight sharpening of the temporally accumulated result
    // by mixing toward the current frame's center sample
    if (sharpness > 0.0) {
        float sharpenWeight = sharpness * 0.1;
        result = mix(result, current, sharpenWeight);
    }

    // Prevent negative values
    result = max(result, vec3(0.0));

    imageStore(outputColor, pixel, vec4(result, 1.0));
}
