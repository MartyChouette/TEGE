#version 460
layout(local_size_x = 8, local_size_y = 8) in;

// ReSTIR DI — Initial Candidate Generation (Importance-Weighted Light Selection)
//
// Two modes:
//   1. BVH traversal (when bvhNodeCount > 0): O(log N) importance-proportional traversal
//      of a light hierarchy tree. At each internal node, pick left/right child proportional
//      to estimated subtree contribution (power * distance proxy). Source PDF = product of
//      path probabilities, giving proper importance weights for unbiased ReSTIR.
//
//   2. Uniform random (fallback): O(1) random selection, weight = targetPdf * totalLights
//
// For each pixel, samples N candidates (via whichever method), selects one
// proportional to its estimated contribution, and writes to reservoir buffer.

// --- Descriptor bindings (shared with RT descriptor set) ---

layout(binding = 2, set = 0) uniform sampler2D depthTex;
layout(binding = 3, set = 0) uniform sampler2D normalTex;

layout(binding = 13, set = 0) uniform LightData {
    vec4 lightDir;
    vec4 lightColor;
    mat4 invViewProj;
    vec2 screenSize;
    uint frameCount;
    float shadowRadius;
    float fireflyClamp;
    int enableNEE;
    int enableMIS;
    int rrMinBounce;
    float rrMinProb;
    uint directionalLightCount;
    uint pointLightCount;
    uint spotLightCount;
} uLight;

// Binding 16: NEE light SSBO
struct RTLight {
    vec3 position;
    float range;
    vec3 direction;
    float intensity;
    vec3 color;
    int type;
    float innerCutoff;
    float outerCutoff;
    float _pad0;
    float _pad1;
};

layout(binding = 16, set = 0) readonly buffer NEELightBuffer {
    RTLight lights[];
};

// Binding 19: Reservoir output buffer
struct Reservoir {
    uint selectedLight;
    float weightSum;
    float sampleWeight;
    uint sampleCount;
};

layout(binding = 19, set = 0) buffer ReservoirBuffer {
    Reservoir reservoirs[];
};

// Binding 27: Light BVH node buffer (optional — empty when BVH disabled)
struct LightBVHNode {
    float boundsMinX, boundsMinY, boundsMinZ;
    float totalPower;
    float boundsMaxX, boundsMaxY, boundsMaxZ;
    int leftChild;       // -1 for leaf
    int rightChild;      // -1 for leaf
    int lightIndex;      // Index into lights[] (leaf only, -1 for internal)
    int lightCount;
    float _pad;
};

layout(binding = 27, set = 0) readonly buffer LightBVHBuffer {
    LightBVHNode bvhNodes[];
};

// Push constants
layout(push_constant) uniform PushConstants {
    uint totalLightCount;
    uint initialCandidates;
    float distanceBias;
    uint frameCount;
    uint bvhNodeCount;       // 0 = use uniform random, >0 = use BVH traversal
} pc;

// ============================================================================
// RNG (PCG)
// ============================================================================

uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint seed) {
    seed = pcg_hash(seed);
    return float(seed) / 4294967296.0;
}

uint init_rng(uvec2 pixel, uint frame) {
    return pcg_hash(pixel.x + pixel.y * 8192u + frame * 65536u);
}

// ============================================================================
// Importance estimation (no shadow ray — geometric term only)
// ============================================================================

float estimateLightContribution(RTLight light, vec3 worldPos, vec3 worldNormal) {
    vec3 toLight;
    float attenuation = 1.0;
    float geometricTerm;

    if (light.type == 0) {
        toLight = -light.direction;
        geometricTerm = max(dot(worldNormal, toLight), 0.0);
    } else if (light.type == 1) {
        vec3 diff = light.position - worldPos;
        float dist2 = dot(diff, diff);
        float dist = sqrt(dist2);
        toLight = diff / max(dist, 1e-6);
        geometricTerm = max(dot(worldNormal, toLight), 0.0);
        attenuation = 1.0 / max(dist2, pc.distanceBias * pc.distanceBias);
        if (light.range > 0.0 && dist > light.range) attenuation = 0.0;
    } else {
        vec3 diff = light.position - worldPos;
        float dist2 = dot(diff, diff);
        float dist = sqrt(dist2);
        toLight = diff / max(dist, 1e-6);
        geometricTerm = max(dot(worldNormal, toLight), 0.0);
        attenuation = 1.0 / max(dist2, pc.distanceBias * pc.distanceBias);
        if (light.range > 0.0 && dist > light.range) attenuation = 0.0;
        float cosAngle = dot(-toLight, light.direction);
        if (cosAngle <= light.outerCutoff) {
            attenuation = 0.0;
        } else if (cosAngle < light.innerCutoff) {
            float t = (cosAngle - light.outerCutoff) /
                      max(light.innerCutoff - light.outerCutoff, 1e-6);
            attenuation *= t * t;
        }
    }

    vec3 emission = light.color * light.intensity;
    float luminance = dot(emission, vec3(0.2126, 0.7152, 0.0722));
    return luminance * attenuation * geometricTerm;
}

// ============================================================================
// BVH traversal — importance-proportional light selection
// ============================================================================

// Estimate the importance of a BVH subtree to a shading point.
// Uses the subtree's total power divided by the squared distance to the nearest
// point on the node's AABB (proxy for average geometric contribution).
float estimateNodeImportance(LightBVHNode node, vec3 worldPos) {
    // Closest point on AABB to worldPos
    vec3 closest = clamp(worldPos,
        vec3(node.boundsMinX, node.boundsMinY, node.boundsMinZ),
        vec3(node.boundsMaxX, node.boundsMaxY, node.boundsMaxZ));
    vec3 diff = worldPos - closest;
    float dist2 = dot(diff, diff) + pc.distanceBias * pc.distanceBias;
    return node.totalPower / dist2;
}

// Traverse BVH to select one light with importance-proportional probability.
// Returns: lightIndex, sets sourcePdf to the product of path probabilities.
uint traverseBVH(vec3 worldPos, vec3 worldNormal, inout uint rng, out float sourcePdf) {
    sourcePdf = 1.0;
    int nodeIdx = 0;

    // Traverse from root to leaf
    for (int depth = 0; depth < 32; ++depth) {  // Max depth guard
        LightBVHNode node = bvhNodes[nodeIdx];

        // Leaf node — return this light
        if (node.leftChild < 0) {
            return uint(node.lightIndex);
        }

        // Internal node — estimate importance of each child
        float leftImp = estimateNodeImportance(bvhNodes[node.leftChild], worldPos);
        float rightImp = estimateNodeImportance(bvhNodes[node.rightChild], worldPos);
        float totalImp = leftImp + rightImp;

        if (totalImp < 1e-10) {
            // Both children have negligible importance — pick randomly
            if (rand_float(rng) < 0.5) {
                sourcePdf *= 0.5;
                nodeIdx = node.leftChild;
            } else {
                sourcePdf *= 0.5;
                nodeIdx = node.rightChild;
            }
        } else {
            float leftProb = leftImp / totalImp;
            if (rand_float(rng) < leftProb) {
                sourcePdf *= leftProb;
                nodeIdx = node.leftChild;
            } else {
                sourcePdf *= (1.0 - leftProb);
                nodeIdx = node.rightChild;
            }
        }
    }

    // Shouldn't reach here — fallback to first light
    return 0u;
}

// ============================================================================
// Reservoir streaming update
// ============================================================================

void updateReservoir(inout Reservoir r, uint lightIndex, float weight, inout uint rng) {
    r.weightSum += weight;
    r.sampleCount += 1u;
    if (rand_float(rng) < (weight / max(r.weightSum, 1e-10))) {
        r.selectedLight = lightIndex;
    }
}

// ============================================================================
// Main
// ============================================================================

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(uLight.screenSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    uint reservoirIdx = uint(pixel.y) * uint(size.x) + uint(pixel.x);

    if (pc.totalLightCount == 0u) {
        reservoirs[reservoirIdx] = Reservoir(0u, 0.0, 0.0, 0u);
        return;
    }

    // Reconstruct world position from depth
    vec2 uv = (vec2(pixel) + 0.5) / uLight.screenSize;
    float depth = texture(depthTex, uv).r;

    if (depth >= 1.0) {
        reservoirs[reservoirIdx] = Reservoir(0u, 0.0, 0.0, 0u);
        return;
    }

    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos4 = uLight.invViewProj * clipPos;
    vec3 worldPos = worldPos4.xyz / worldPos4.w;
    vec3 worldNormal = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);

    Reservoir r;
    r.selectedLight = 0u;
    r.weightSum = 0.0;
    r.sampleWeight = 0.0;
    r.sampleCount = 0u;

    uint rng = init_rng(uvec2(pixel), pc.frameCount);
    uint N = min(pc.initialCandidates, pc.totalLightCount);

    bool useBVH = (pc.bvhNodeCount > 0u);

    for (uint i = 0u; i < N; ++i) {
        uint lightIdx;
        float sourcePdf;

        if (useBVH) {
            // BVH traversal: importance-proportional selection
            lightIdx = traverseBVH(worldPos, worldNormal, rng, sourcePdf);
            lightIdx = min(lightIdx, pc.totalLightCount - 1u);
        } else {
            // Uniform random fallback
            lightIdx = uint(rand_float(rng) * float(pc.totalLightCount));
            lightIdx = min(lightIdx, pc.totalLightCount - 1u);
            sourcePdf = 1.0 / float(pc.totalLightCount);
        }

        float targetPdf = estimateLightContribution(lights[lightIdx], worldPos, worldNormal);
        float weight = targetPdf / max(sourcePdf, 1e-10);

        updateReservoir(r, lightIdx, weight, rng);
    }

    // Compute unbiased sample weight
    float selectedTargetPdf = estimateLightContribution(
        lights[r.selectedLight], worldPos, worldNormal);

    if (selectedTargetPdf > 1e-10 && r.sampleCount > 0u) {
        r.sampleWeight = (r.weightSum / float(r.sampleCount)) / selectedTargetPdf;
    } else {
        r.sampleWeight = 0.0;
    }

    reservoirs[reservoirIdx] = r;
}
