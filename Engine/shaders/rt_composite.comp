#version 460
layout(local_size_x = 8, local_size_y = 8) in;

// Composite RT layers into scene HDR image:
// - Multiply shadow factor
// - Add reflection contribution (modulated by metallic)
// - Multiply AO factor
// - Add GI contribution

layout(binding = 1, rgba16f) uniform image2D sceneHDR;
layout(binding = 5, r16f) uniform image2D shadowImg;     // R16F: 0=shadow, 1=lit
layout(binding = 6, rgba16f) uniform image2D reflectImg; // RGBA16F
layout(binding = 7, r16f) uniform image2D aoImg;         // R16F: 0=occluded, 1=open
layout(binding = 8, rgba16f) uniform image2D giImg;      // RGBA16F

layout(push_constant) uniform PushConstants {
    float shadowStrength;
    float reflectionStrength;
    float aoStrength;
    float giStrength;
    int enableFlags;  // bit 0=shadow, 1=reflect, 2=ao, 3=gi
    int pad1, pad2, pad3;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sceneHDR);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 color = imageLoad(sceneHDR, pixel);

    // RT Shadows — multiply
    if ((pc.enableFlags & 1) != 0) {
        float shadow = imageLoad(shadowImg, pixel).r;
        float factor = mix(1.0, shadow, pc.shadowStrength);
        color.rgb *= factor;
    }

    // RT AO — multiply
    if ((pc.enableFlags & 4) != 0) {
        float ao = imageLoad(aoImg, pixel).r;
        float factor = mix(1.0, ao, pc.aoStrength);
        color.rgb *= factor;
    }

    // RT Reflections — additive
    if ((pc.enableFlags & 2) != 0) {
        vec3 reflection = imageLoad(reflectImg, pixel).rgb;
        color.rgb += reflection * pc.reflectionStrength;
    }

    // RT GI — additive
    if ((pc.enableFlags & 8) != 0) {
        vec3 gi = imageLoad(giImg, pixel).rgb;
        color.rgb += gi * pc.giStrength;
    }

    imageStore(sceneHDR, pixel, color);
}
