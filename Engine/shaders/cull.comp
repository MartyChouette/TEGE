#version 450

// GPU Frustum Culling Compute Shader with Atomic Compaction

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: Objects to cull (layout matches C++ CullableObject, std430)
struct CullableObject {
    vec4 boundsMin;      // xyz = min, w = padding
    vec4 boundsMax;      // xyz = max, w = padding
    mat4 transform;      // Object transform
    uint meshIndex;
    uint materialIndex;
    uint indexCount;
    uint indexOffset;
    uint vertexOffset;
    uint indirectEligible; // 1 = emit indirect draw command, 0 = visibility only
    uint _pad1;
    uint _pad2;
};

layout(set = 0, binding = 0) readonly buffer ObjectBuffer {
    CullableObject objects[];
};

// Output: Indirect draw commands (compacted — only visible objects)
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 1) writeonly buffer IndirectDrawBuffer {
    DrawCommand drawCommands[];
};

// Frustum planes
layout(set = 0, binding = 2) uniform FrustumBuffer {
    vec4 frustumPlanes[6]; // left, right, bottom, top, near, far
};

// Visibility flags (per-object, for CPU-side queries)
layout(set = 0, binding = 3) writeonly buffer VisibilityBuffer {
    uint visibility[];
};

// Atomic draw count (reset to 0 before dispatch via vkCmdFillBuffer)
layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint drawCount;
};

// Check if AABB is inside frustum
bool IsAABBVisible(vec3 aabbMin, vec3 aabbMax, mat4 transform) {
    // Transform AABB corners to world space
    vec3 corners[8];
    corners[0] = vec3(transform * vec4(aabbMin.x, aabbMin.y, aabbMin.z, 1.0));
    corners[1] = vec3(transform * vec4(aabbMax.x, aabbMin.y, aabbMin.z, 1.0));
    corners[2] = vec3(transform * vec4(aabbMin.x, aabbMax.y, aabbMin.z, 1.0));
    corners[3] = vec3(transform * vec4(aabbMax.x, aabbMax.y, aabbMin.z, 1.0));
    corners[4] = vec3(transform * vec4(aabbMin.x, aabbMin.y, aabbMax.z, 1.0));
    corners[5] = vec3(transform * vec4(aabbMax.x, aabbMin.y, aabbMax.z, 1.0));
    corners[6] = vec3(transform * vec4(aabbMin.x, aabbMax.y, aabbMax.z, 1.0));
    corners[7] = vec3(transform * vec4(aabbMax.x, aabbMax.y, aabbMax.z, 1.0));

    // Check against each frustum plane
    for (int plane = 0; plane < 6; plane++) {
        bool inside = false;

        // Check if any corner is inside this plane
        for (int i = 0; i < 8; i++) {
            float distance = dot(frustumPlanes[plane].xyz, corners[i]) + frustumPlanes[plane].w;
            if (distance >= 0.0) {
                inside = true;
                break;
            }
        }

        // If all corners are outside any plane, object is culled
        if (!inside) {
            return false;
        }
    }

    return true;
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= objects.length()) {
        return;
    }

    CullableObject obj = objects[index];
    vec3 boundsMin = obj.boundsMin.xyz;
    vec3 boundsMax = obj.boundsMax.xyz;

    // Check visibility
    bool visible = IsAABBVisible(boundsMin, boundsMax, obj.transform);

    visibility[index] = visible ? 1u : 0u;

    if (visible && obj.indirectEligible != 0u) {
        // Atomic compaction: allocate a slot in the output buffer.
        // Only indirect-eligible objects (non-textured, pool-allocated) emit draw commands.
        // Textured entities are still visibility-tested but drawn via per-entity path.
        uint slot = atomicAdd(drawCount, 1);

        DrawCommand cmd;
        cmd.indexCount = obj.indexCount;
        cmd.instanceCount = 1;
        cmd.firstIndex = obj.indexOffset;
        cmd.vertexOffset = int(obj.vertexOffset);
        cmd.firstInstance = index; // Original object index for ObjectData lookup
        drawCommands[slot] = cmd;
    }
}
