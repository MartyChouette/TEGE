#version 450

// GPU Frustum + Two-Phase Hi-Z Occlusion Culling Compute Shader
// Phase 0: Frustum cull all objects. Visible objects that pass frustum but fail HiZ are flagged
//          as "potentially occluded" for re-testing after partial HiZ update.
// Phase 1: Re-test only the potentially-occluded set against updated HiZ pyramid.
//          Objects that pass phase 1 are appended to the indirect draw buffer.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Push constant to select phase (0 or 1)
layout(push_constant) uniform PushConstants {
    uint phase;  // 0 = initial cull, 1 = re-test occluded
} pc;

struct CullableObject {
    vec4 boundsMin;
    vec4 boundsMax;
    mat4 transform;
    uint meshIndex;
    uint materialIndex;
    uint indexCount;
    uint indexOffset;
    uint vertexOffset;
    uint indirectEligible; // 1 = emit indirect draw command, 0 = visibility only
    uint _pad1;
    uint _pad2;
};

layout(set = 0, binding = 0) readonly buffer ObjectBuffer {
    CullableObject objects[];
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 1) writeonly buffer IndirectDrawBuffer {
    DrawCommand drawCommands[];
};

layout(set = 0, binding = 2) uniform FrustumBuffer {
    vec4 frustumPlanes[6];
    mat4 viewProj;        // View-projection matrix for screen-space projection
    vec2 screenSize;      // Render target width, height
    float nearPlane;
    float _fpad;
};

layout(set = 0, binding = 3) buffer VisibilityBuffer {
    uint visibility[];
};

layout(set = 0, binding = 4) buffer DrawCountBuffer {
    uint drawCount;
};

// Hi-Z depth pyramid (previous frame for phase 0, partial update for phase 1)
layout(set = 0, binding = 5) uniform sampler2D hizPyramid;

// Occlusion flags buffer: 0 = definitely visible, 1 = potentially occluded (needs phase 1 re-test)
layout(set = 0, binding = 6) buffer OcclusionFlagBuffer {
    uint occlusionFlags[];
};

bool IsAABBVisible(vec3 aabbMin, vec3 aabbMax, mat4 transform) {
    vec3 corners[8];
    corners[0] = vec3(transform * vec4(aabbMin.x, aabbMin.y, aabbMin.z, 1.0));
    corners[1] = vec3(transform * vec4(aabbMax.x, aabbMin.y, aabbMin.z, 1.0));
    corners[2] = vec3(transform * vec4(aabbMin.x, aabbMax.y, aabbMin.z, 1.0));
    corners[3] = vec3(transform * vec4(aabbMax.x, aabbMax.y, aabbMin.z, 1.0));
    corners[4] = vec3(transform * vec4(aabbMin.x, aabbMin.y, aabbMax.z, 1.0));
    corners[5] = vec3(transform * vec4(aabbMax.x, aabbMin.y, aabbMax.z, 1.0));
    corners[6] = vec3(transform * vec4(aabbMin.x, aabbMax.y, aabbMax.z, 1.0));
    corners[7] = vec3(transform * vec4(aabbMax.x, aabbMax.y, aabbMax.z, 1.0));

    for (int plane = 0; plane < 6; plane++) {
        bool inside = false;
        for (int i = 0; i < 8; i++) {
            float distance = dot(frustumPlanes[plane].xyz, corners[i]) + frustumPlanes[plane].w;
            if (distance >= 0.0) {
                inside = true;
                break;
            }
        }
        if (!inside) return false;
    }
    return true;
}

// Project AABB to screen-space and test against Hi-Z pyramid
bool IsOccluded(vec3 aabbMin, vec3 aabbMax, mat4 transform) {
    // Project all 8 corners to clip space, find screen-space AABB
    float minX = 1.0, maxX = -1.0;
    float minY = 1.0, maxY = -1.0;
    float minZ = 1.0; // Closest depth (Vulkan: 0=near, 1=far)
    bool behindCamera = false;

    for (int i = 0; i < 8; i++) {
        vec3 corner;
        corner.x = ((i & 1) != 0) ? aabbMax.x : aabbMin.x;
        corner.y = ((i & 2) != 0) ? aabbMax.y : aabbMin.y;
        corner.z = ((i & 4) != 0) ? aabbMax.z : aabbMin.z;

        vec4 worldPos = transform * vec4(corner, 1.0);
        vec4 clipPos = viewProj * worldPos;

        if (clipPos.w <= nearPlane) {
            behindCamera = true;
            break;
        }

        vec3 ndc = clipPos.xyz / clipPos.w;
        minX = min(minX, ndc.x);
        maxX = max(maxX, ndc.x);
        minY = min(minY, ndc.y);
        maxY = max(maxY, ndc.y);
        minZ = min(minZ, ndc.z); // Closest depth of the AABB
    }

    // If any corner is behind the camera, conservatively mark as visible
    if (behindCamera) return false;

    // If entirely off-screen, frustum test already handled it
    if (maxX < -1.0 || minX > 1.0 || maxY < -1.0 || minY > 1.0) return false;

    // Clamp to screen
    minX = clamp(minX, -1.0, 1.0);
    maxX = clamp(maxX, -1.0, 1.0);
    minY = clamp(minY, -1.0, 1.0);
    maxY = clamp(maxY, -1.0, 1.0);

    // Convert NDC to UV [0,1]
    vec2 uvMin = vec2(minX, minY) * 0.5 + 0.5;
    vec2 uvMax = vec2(maxX, maxY) * 0.5 + 0.5;

    // Compute screen-space AABB size to select mip level
    vec2 screenMin = uvMin * screenSize;
    vec2 screenMax = uvMax * screenSize;
    vec2 screenExtent = screenMax - screenMin;
    float maxExtent = max(screenExtent.x, screenExtent.y);

    // Select mip level: want the mip where the AABB covers ~1 texel
    float mipLevel = max(0.0, ceil(log2(maxExtent)));

    // Sample Hi-Z at center of the screen-space AABB
    vec2 uvCenter = (uvMin + uvMax) * 0.5;
    float occluderDepth = textureLod(hizPyramid, uvCenter, mipLevel).r;

    // If the closest point of the AABB is behind the occluder depth -> occluded
    return minZ > occluderDepth;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= objects.length()) return;

    if (pc.phase == 0) {
        // Phase 0: Full frustum + Hi-Z occlusion cull
        CullableObject obj = objects[index];
        vec3 boundsMin = obj.boundsMin.xyz;
        vec3 boundsMax = obj.boundsMax.xyz;

        bool visible = IsAABBVisible(boundsMin, boundsMax, obj.transform);
        bool occluded = false;

        if (visible) {
            occluded = IsOccluded(boundsMin, boundsMax, obj.transform);
            if (occluded) {
                visible = false;
            }
        }

        // Write visibility and occlusion flags
        visibility[index] = visible ? 1u : 0u;
        occlusionFlags[index] = (occluded) ? 1u : 0u;

        if (visible && obj.indirectEligible != 0u) {
            uint slot = atomicAdd(drawCount, 1);
            DrawCommand cmd;
            cmd.indexCount = obj.indexCount;
            cmd.instanceCount = 1;
            cmd.firstIndex = obj.indexOffset;
            cmd.vertexOffset = int(obj.vertexOffset);
            cmd.firstInstance = index;
            drawCommands[slot] = cmd;
        }
    } else {
        // Phase 1: Re-test only objects that were flagged as potentially occluded
        if (occlusionFlags[index] == 0u) return;

        CullableObject obj = objects[index];
        vec3 boundsMin = obj.boundsMin.xyz;
        vec3 boundsMax = obj.boundsMax.xyz;

        // Re-test against updated Hi-Z pyramid (built from phase 0 visible objects)
        bool stillOccluded = IsOccluded(boundsMin, boundsMax, obj.transform);

        if (!stillOccluded) {
            // Object is now visible — append to draw buffer
            visibility[index] = 1u;
            occlusionFlags[index] = 0u;

            if (obj.indirectEligible != 0u) {
                uint slot = atomicAdd(drawCount, 1);
                DrawCommand cmd;
                cmd.indexCount = obj.indexCount;
                cmd.instanceCount = 1;
                cmd.firstIndex = obj.indexOffset;
                cmd.vertexOffset = int(obj.vertexOffset);
                cmd.firstInstance = index;
                drawCommands[slot] = cmd;
            }
        }
    }
}
